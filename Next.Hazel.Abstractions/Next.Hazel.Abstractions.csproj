<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Next.Hazel.Abstractions</RootNamespace>
        <AssemblyName>Next.Hazel.Abstractions</AssemblyName>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageId>Empostor.Hazel.Abstractions</PackageId>
        <Description>Core abstractions for the Empostor network transport library. Fork of Hazel with modern .NET support.</Description>
    </PropertyGroup>

</Project>
